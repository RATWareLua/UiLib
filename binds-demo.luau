--!nocheck
--=============================================================================
-- Витрина привязок
--=============================================================================
--
-- Проверяет ровно ядро привязок и ничего больше: остальное показывает demo.luau.
--
--     execute-file  filePath = ...\lib\dist\BindDemo.luau
--
-- ЧТО СМОТРЕТЬ РУКАМИ
--
--   1. Открыть меню (Delete). В списке слева -- только те привязки, у которых
--      клавиша назначена. У ЛЕТАТЬ и ФОНАРЬ её нет, и это рабочее состояние.
--   2. Правая кнопка по строке -- КЛАВИША и РЕЖИМ. Назначить, снять Backspace,
--      отменить Escape.
--   3. Нажать назначенную клавишу с ЗАКРЫТЫМ меню -- строка переключается,
--      список это показывает.
--   4. Переставить РЕЖИМ у ЛЕТАТЬ в ЗАЖАТИЕ -- работает, только пока держишь.
--   5. Щёлкнуть КЛАВИША в одной строке, не нажимая ничего щёлкнуть в другой --
--      первая ОТМЕНЯЕТСЯ. Раньше ждали обе и назначались обе.
--   6. Назначить правую кнопку мыши. Раньше настройки принимали только
--      клавиатуру и молча теряли тип.
--   7. СОХРАНИТЬ -> перезапустить -> ЗАГРУЗИТЬ: клавиша и режим возвращаются.

local NOTE = "[binds] "

--=============================================================================
-- УБОРКА ЗА ПРОШЛЫМ ЗАПУСКОМ
--=============================================================================
--
-- Витрину перезапускают десятки раз подряд, и каждый запуск -- НОВАЯ библиотека:
-- сборка самодостаточна, общей таблицы между запусками нет. Значит и реестра
-- окон нет, и прошлое окно о себе никому не сообщит -- оно просто остаётся
-- висеть на экране вместе с перехватом ввода.
--
-- Своё прошлое окно убираем по ссылке в окружении. Чужих следов -- по форме: у
-- окна NierUI это ScreenGui с DisplayOrder 999 и IgnoreGuiInset. Спутать не с
-- чем, а иначе после десятка прогонов на экране стопка из десяти меню, и
-- щелчок доходит только до верхнего.
--
-- В самой библиотеке ничего подобного нет и быть не должно: это забота витрины,
-- которую перезапускают, а не библиотеки, которую подключают.

local ENV = getgenv and getgenv() or _G

if ENV.__bindDemo then
    pcall(function() ENV.__bindDemo:Destroy() end)
    ENV.__bindDemo = nil
end

local function sweep(parent)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("ScreenGui") and child.DisplayOrder == 999
            and child.IgnoreGuiInset then
            pcall(function() child:Destroy() end)
        end
    end
end

pcall(function()
    if type(gethui) == "function" then sweep(gethui()) end
    sweep(game:GetService("CoreGui"))
end)

--=============================================================================

local win = NierUI:Window({
    Title = "BINDS",
    Subtitle = "CORE / DEMO",
    ConfigFolder = "nierui-binds",
    Hint = "правая кнопка по строке -- клавиша и режим",
    AutoLoad = false,
})

--== фичи, которых нет =======================================================
--
-- Витрине нечего включать по-настоящему, поэтому «фича» здесь -- переменная и
-- строка в консоли. Важно, что ядру всё равно: оно зовёт Callback и не знает,
-- что за ним стоит.

local function feature(name)
    return function(on)
        print(NOTE .. name .. (on and " -> ON" or " -> OFF"))
    end
end

--=============================================================================

local main = win:Tab("ПРИВЯЗКИ")

--== РУБИЛЬНИК ===============================================================
--
-- Цель -- сама строка. Нажал -- функция включилась, нажал -- выключилась.
-- Ворот у него нет: выключенную строку иначе нечем было бы включить.

-- САМОЕ КОРОТКОЕ ОБЪЯВЛЕНИЕ: две строки, и это уже полноценная привязка --
-- она в списке, у неё правится клавиша и режим, и всё это идёт в профиль.
local fly = main:Toggle({
    Text = "ЛЕТАТЬ", Flag = "fly", Bind = true, ChangeModeInGame = true,
    Desc = "Рубильник без клавиши. Назначь правой кнопкой -- ядро не требует.",
    Callback = feature("ЛЕТАТЬ"),
})

-- Стартовая клавиша -- удобство, а не обязанность. Человек её всё равно
-- перебьёт, если захочет.
main:Toggle({
    Text = "СКВОЗЬ СТЕНЫ", Flag = "noclip", Bind = Enum.KeyCode.N,
    Desc = "Тот же рубильник, просто предзаполнен.",
    Callback = feature("СКВОЗЬ СТЕНЫ"),
})

-- Режим задаётся и в коде -- но это лишь НАЧАЛЬНОЕ положение: человек
-- переставит его в меню строки.
main:Toggle({
    Text = "ПРИЦЕЛ", Flag = "zoom", Bind = Enum.KeyCode.C, Kind = "hold",
    Desc = "Заведён ЗАЖАТИЕМ: работает, пока держишь клавишу.",
    Callback = feature("ПРИЦЕЛ"),
})

main:Divider()

--== ВЗАИМОДЕЙСТВИЯ ==========================================================
--
-- Цель -- сама функция. Строка для них МАСТЕР-СВИТЧ: пока ON, они действуют;
-- выключил -- безусловно уходят в OFF и молчат, сколько ни жми. Свой статус
-- строка при этом не меняет никогда.

-- КРУТИТЬ РЕЖИМ РАЗРЕШАЕТ СКРИПТЕР, ЯВНО.
--
-- ChangeModeInGame = true -- и строка РЕЖИМ появляется у этой привязки в меню
-- правой кнопки. Нет флага -- режим стоит там, куда его поставили в коде, и
-- человек его не трогает. Ни из чего это не выводится: молчание значит молчание.
--
-- Ротейт заведён ЗАЖАТИЕМ -- «пока держу Q, смотрю влево», как оно и работает в
-- жизни, -- но выбор открыт: кому-то удобнее залипание. Каждая из трёх
-- переставляется отдельно от соседей.

--== ДВА ВЗАИМОДЕЙСТВИЯ НА ОДНУ ФУНКЦИЮ: КТО ГЛАВНЕЕ ==========================
--
-- ЯДРО НЕ АРБИТР, И ЭТО НАМЕРЕННО. Зажали Q и E разом -- обе привязки честно в
-- ON, каждая со своим состоянием. Ядро не знает, что «влево» и «вправо»
-- противоречат друг другу: это знание про ФУНКЦИЮ, а не про клавиши, и живёт
-- оно здесь.
--
-- Здесь стоял наивный образец: rotation = on and side or 0. Замер показал, чем
-- он плох. Зажали Q, зажали E -- поворот 45, последний нажатый побеждает, всё
-- верно. А вот отпустили Q -- и поворот обнулился, хотя E всё ещё держат.
-- Отпускание одного стирало работу другого.
--
-- Поэтому стопка зажатых: побеждает последний нажатый, а отпустив его,
-- возвращаемся к тому, что ещё держат. Ровно как ждёт рука.
local rotation = 0
local held = {}

local function look(side)
    return function(on)
        if on then
            held[#held + 1] = side
        else
            for i = #held, 1, -1 do
                if held[i] == side then table.remove(held, i) end
            end
        end
        rotation = held[#held] or 0
        print(NOTE .. "ротейт: " .. rotation)
    end
end

local antiaim = main:Toggle({
    Text = "АНТИАИМ", Flag = "aa", Default = true,
    Desc = "Строка -- ворота. Клавишей её не переключить: рубильника у неё нет.",
    Callback = feature("АНТИАИМ"),
    Binds = {
        { Text = "ВЛЕВО", Flag = "aaLeft", Key = Enum.KeyCode.Q,
          Kind = "hold", ChangeModeInGame = true, Toggle = look(-45) },
        { Text = "ВПРАВО", Flag = "aaRight", Key = Enum.KeyCode.E,
          Kind = "hold", ChangeModeInGame = true, Toggle = look(45) },
        -- Без флага: фристенд имеет смысл только залипанием, и давать выбор
        -- здесь значило бы предложить человеку сломать себе фичу.
        { Text = "ФРИСТЕНД", Flag = "aaFree", Key = Enum.KeyCode.F,
          Toggle = function(on) print(NOTE .. "фристенд " .. (on and "ON" or "OFF")) end },
    },
})

-- И РУБИЛЬНИК, И ВЗАИМОДЕЙСТВИЕ НА ОДНОЙ СТРОКЕ. Одной клавишей рубим функцию
-- целиком, другой работаем с ней, пока она включена.
main:Toggle({
    Text = "ОТДАЧА", Flag = "recoil",
    Bind = Enum.KeyCode.R,
    Desc = "R рубит функцию целиком, T переключает её режим -- но только пока ON.",
    Callback = feature("ОТДАЧА"),
    Binds = {
        { Text = "УСИЛЕНИЕ", Flag = "recoilBoost", Key = Enum.KeyCode.T,
          Toggle = function(on) print(NOTE .. "усиление " .. (on and "ON" or "OFF")) end },
    },
})

-- Строка без Bind остаётся обычной строкой: ядро о ней не знает.
main:Toggle({
    Text = "БЕЗ ПРИВЯЗКИ", Flag = "plain", Default = true,
    Desc = "Привязки нет вовсе -- в списке её не будет.",
    Callback = feature("БЕЗ ПРИВЯЗКИ"),
})

main:Divider()

--== ОДНОРАЗОВЫЕ -- ОТДЕЛЬНЫЙ ВИД ============================================
--
-- Сработало и кончилось. Состояния нет: нет момента, про который можно
-- спросить «фонарь сейчас включён?». Значит и режима нет -- удерживать нечего,
-- переключать нечего. В списке у них [BUTTON].
--
-- ChangeModeInGame такой привязке -- ОШИБКА, а не молчаливый отказ: иначе
-- скриптер будет уверен, что дал человеку выбор, а выбора не появится.

main:Button({
    Text = "ФОНАРЬ", Flag = "flash", Bind = true,
    Desc = "Действие: сработало и всё. Режима нет и быть не может.",
    Callback = function() print(NOTE .. "ФОНАРЬ сработал") end,
})

-- Своё меню никуда не делось: редакторы ядра встают сверху, дописанное -- под
-- ними, через разделитель. Заявка на правую кнопку при этом одна.
main:Toggle({
    Text = "СЛЕД", Flag = "trail", Bind = Enum.KeyCode.G,
    Desc = "У строки и привязка, и собственное меню.",
    Callback = feature("СЛЕД"),
    Menu = function(m)
        m:Slider({ Text = "ДЛИНА", Flag = "trailLen", Min = 1, Max = 60, Default = 12 })
        m:ColorPicker({ Text = "ЦВЕТ", Flag = "trailColor",
                        Default = Color3.fromRGB(120, 180, 255) })
    end,
})

--== управление извне ========================================================

local api = win:Tab("ЯДРО")

