api:Divider()

-- ВЕСЬ СТОРОННИЙ МЕНЕДЖЕР -- ВОТ ЭТО. Ни одного обращения во внутренности.
api:Button({
    Text = "ВЫПИСАТЬ РЕЕСТР",
    Desc = "Печатает то же, что видит список привязок: All() и ручки.",
    Callback = function()
        print(NOTE .. "---- реестр ----")
        for _, bind in ipairs(win.binds:All()) do
            local state = bind:Get()
            print(("%s%-16s %-12s %-8s %s"):format(
